# API Keys
OPENAI_API_KEY=your_openai_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Database
DATABASE_URL=postgresql://user:password@localhost/googlemaptowebsite

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Application
APP_ENV=development
SECRET_KEY=your_secret_key_change_in_production
API_VERSION=v1

# Deployment Region
DEFAULT_LANGUAGE=hu
SUPPORTED_LANGUAGES=hu,en,de,fr,es,it

# AI Configuration
AI_MODEL=gpt-4
AI_TEMPERATURE=0.7
MAX_TOKENS=2000

# Marketing Automation
EMAIL_SENDER=noreply@yourdomain.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
